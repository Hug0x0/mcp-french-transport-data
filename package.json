{
  "name": "mcp-french-transport-data",
  "version": "0.1.0",
  "description": "MCP server for transport.data.gouv.fr: datasets, GTFS resources, regions, networks, and data-quality discovery.",
  "type": "module",
  "bin": {
    "mcp-french-transport-data": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "open-data",
    "france",
    "transport",
    "gtfs",
    "mobility",
    "transport-data-gouv"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-french-transport-data.git"
  },
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-french-transport-data/issues"
  },
  "homepage": "https://github.com/Hug0x0/mcp-french-transport-data#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
